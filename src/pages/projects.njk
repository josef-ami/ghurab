---
layout: base
title: Projects
description: 'One page per project -- whitepapers, source repos, and CAD.'
pagination:
  data: collections.allProjects
  size: 6
permalink: 'projects/{% if pagination.pageNumber >=1 %}page-{{ pagination.pageNumber + 1 }}/{% endif %}index.html'
---

<div class="wrapper">
  <header class="full | section spot-color-theme-secondary">
    <div class="section__inner flow region" style="--region-space-top: var(--space-xl-2xl)">
      <h1 class="text-center text-theme-light">{{ title }}</h1>
    </div>

    {% svg "divider/edgy", null, "divider" %}
  </header>

  <custom-masonry layout="50-50">
    {% asyncEach item in pagination.items %}
      {% include "partials/card-project.njk" %}
    {% endeach %}
  </custom-masonry>

  {% set collectionToPaginate = collections.projects %}
  {% set metaKey = "projects" %}
  {% if collectionToPaginate.length > pagination.size %}
    {% include 'partials/pagination.njk' %}
  {% endif %}
</div>
