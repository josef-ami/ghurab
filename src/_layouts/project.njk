---
layout: base
schema: CreativeWork
---

<div class="region" style="--region-space-top: var(--space-xl-2xl)">
  <div class="wrapper flow prose">
    <h1 class="font-display">{{ title }}</h1>

    <p class="text-theme-text-accent">{{ summary }}</p>

    <p class="meta | cluster gutter-xs-s">
      {% set definedDate = date %} {% include "partials/date.njk" %}
      {% if tags.length > 1 %}
        {% for tag in tags %}{% if tag != "projects" %}
          <a class="button" href="/tags/{{ tag | slugify }}/" data-small-button> {{ tag }} </a>
        {% endif %}{% endfor %}
      {% endif %}
    </p>

    {#- Links row: only renders links for fields that are actually filled in.
       An entry with none of the three (early-stage project, nothing public
       yet) just shows no links row at all -- no dead/empty buttons. #}
    {% if whitepaperUrl or repoUrl or cadUrl %}
      <p class="cluster gutter-xs-s">
        {% if whitepaperUrl %}
          <a class="button" data-button-variant="primary" href="{{ whitepaperUrl }}">Whitepaper (PDF)</a>
        {% endif %}
        {% if repoUrl %}
          <a class="button" data-button-variant="secondary" href="{{ repoUrl }}">Source repo</a>
        {% endif %}
        {% if cadUrl and not viewer %}
          <a class="button" data-button-variant="secondary" href="{{ cadUrl }}">CAD files</a>
        {% endif %}
      </p>
    {% endif %}

    {% if viewer %}
      {#- Flagship project (roadmap Phase 5: viewer for 2-3 projects only).
         <model-viewer> is loaded per-page rather than site-wide -- it's a
         heavy web component and only these pages need it.

         Loaded from a CDN, which is the documented distribution route for
         this component. Note it's the only third-party runtime dependency
         on the site; if that matters, vendor the module into
         src/assets/scripts/ and point the src at the local copy instead.

         Degrades to the CAD link below if the script fails or JS is off. #}
      <script
        type="module"
        src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.5.0/model-viewer.min.js"
      ></script>

      {% if modelUrl %}
        <model-viewer
          class="project-viewer"
          src="{{ modelUrl }}"
          alt="Interactive 3D model of {{ title }}"
          camera-controls
          touch-action="pan-y"
          auto-rotate
          shadow-intensity="1"
          loading="lazy"
        >
          <p slot="poster" class="text-theme-text-accent">Loading 3D model…</p>
        </model-viewer>
      {% else %}
        <div class="project-viewer__empty">
          <p class="text-theme-text-accent">
            Flagged for the 3D viewer, but no <code>modelUrl</code> is set in this project's front matter yet.
            Add a glTF/GLB export to enable it.
            {% if cadUrl %}In the meantime: <a href="{{ cadUrl }}">CAD source</a>.{% endif %}
          </p>
        </div>
      {% endif %}
    {% endif %}

    {{ content | safe }}
  </div>
</div>

{%- css "local" -%}
  {%- include 'css/project.css' -%}
{%- endcss -%}
